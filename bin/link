#!/usr/bin/env bash
# build pgfmt from this checkout and symlink it ahead of the homebrew version
# usage: ./bin/link [dest-dir]
#   dest-dir defaults to $(brew --prefix)/bin if brew is available, otherwise /usr/local/bin
set -euo pipefail

repo="$(cd -P "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -n "${1:-}" ]; then
  dest_dir="$1"
elif command -v brew >/dev/null 2>&1; then
  dest_dir="$(brew --prefix)/bin"
else
  dest_dir="/usr/local/bin"
fi

(cd "$repo" && go build -ldflags "-X main.version=dev-$(git rev-parse --short HEAD 2>/dev/null || echo local)" -o local/bin/pgfmt ./cmd/pgfmt)

dest="$dest_dir/pgfmt"
mkdir -p "$dest_dir"
ln -sf "$repo/local/bin/pgfmt" "$dest"
echo "linked: $dest -> $repo/local/bin/pgfmt"
echo "rerun ./bin/link after changes to rebuild"
